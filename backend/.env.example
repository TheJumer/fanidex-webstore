# ============================================================================
# FaniDex / Minecraft Webstore — Backend Environment Configuration
# Copy this file to ".env" in the same folder and fill in real values.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows cmd)
# NEVER commit the real ".env" file — it is already in .gitignore.
# ============================================================================

# ----- Server -----
APP_PORT=8080
APP_ENV=development
# Public base URL of this API (used for webhook redirect URLs, etc.)
APP_BASE_URL=http://localhost:8080
# URL of the deployed frontend (used for payment-gateway redirects)
FRONTEND_URL=http://localhost:5173

# ----- Master encryption key (AES-256-GCM) -----
# MUST be a 32-byte key, hex or base64 encoded. Used to encrypt RCON passwords,
# payment gateway secrets, TOTP secrets and the plugin HMAC secret at rest.
# Generate one with:
#   openssl rand -hex 32
# Losing/rotating this key makes all previously encrypted secrets unrecoverable —
# back it up securely (password manager / secrets vault) and NEVER commit it.
APP_MASTER_KEY=replace_with_output_of_openssl_rand_-hex_32

# ----- JWT (admin session tokens) -----
# Generate separate random secrets, e.g.:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_HOURS=168

# ----- Database (driver factory) -----
# DB_DRIVER = sqlite | postgres | mysql
# SQLite requires zero setup and is the default — great for local dev/small shops.
DB_DRIVER=sqlite
DB_DSN=webstore.db

# Postgres example:
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=postgres password=postgres dbname=webstore port=5432 sslmode=disable

# MySQL example:
# DB_DRIVER=mysql
# DB_DSN=user:password@tcp(127.0.0.1:3306)/webstore?charset=utf8mb4&parseTime=True&loc=Local

# ----- Initial admin account (seeded automatically on first run) -----
# Change these before the first `go run` in any shared/public environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Str0ng!

# ----- Security -----
# Comma-separated list of IPs allowed to reach /admin routes. Empty = allow all.
ADMIN_IP_WHITELIST=
# Set to true in production (requires HTTPS) so cookies are sent with Secure flag.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Comma-separated list of allowed CORS origins (your deployed frontend URL(s)).
CORS_ORIGINS=http://localhost:5173

# ----- Background expiry worker -----
# How often (seconds) the ticker checks for expired temporary ranks/grants.
EXPIRY_TICK_SECONDS=60
